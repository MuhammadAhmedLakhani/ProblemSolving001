//2: Find the highest score and its position in the array, using a loop (don't use Math.max).

let highest = scores[0];
let highestIndex = 0;

for (let i = 0; i < scores.length; i++) {
    if (scores[i] >= highest) {
        highest = scores[i]
        highestIndex = i
    }    
}

console.log(highestIndex);


//3: Count how many times each score appears. Hint: 90 appears twice. Use an object as the tally.


let scoreTally = {};

for (let i = 0; i < scores.length; i++) {
    let score = scores[i];
    if(scoreTally[score] === undefined) {
        scoreTally[score] = 1;
    }else {
        scoreTally[score] = scoreTally[score] + 1
    }   
}

console.log(scoreTally)